# ------------------------------------------------------------------
# HERMAN FASHION — variables d'environnement
# Copiez ce fichier en .env.local (développement) ou saisissez ces
# variables dans votre hébergeur (Vercel, VPS…).
# ------------------------------------------------------------------

# Adresse publique du site (SEO, sitemap, partages)
NEXT_PUBLIC_SITE_URL=https://www.hermanfashion.cm

# Base PostgreSQL (Neon, Supabase, Railway, serveur…).
# Si absent : base PostgreSQL embarquée dans .data/pglite (démo / petit serveur).
DATABASE_URL=

# Clé secrète des sessions (obligatoire en production, 32+ caractères aléatoires)
# Générer : openssl rand -base64 48
AUTH_SECRET=

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@hermanfashion.cm
ADMIN_PASSWORD=

# HERMAN AI — clé API Anthropic (facultatif : sans clé, l'assistant répond depuis la FAQ)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_HOURLY_LIMIT=40

# Stockage des photos/vidéos envoyées depuis l'administration (obligatoire sur Vercel)
BLOB_READ_WRITE_TOKEN=

# Migrations automatiques au démarrage (true par défaut)
AUTO_MIGRATE=true
